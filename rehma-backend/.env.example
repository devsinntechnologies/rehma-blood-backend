# JWT
JWT_SECRET=change-me-in-production

# PostgreSQL (TypeORM). In staging/production set TYPEORM_SYNCHRONIZE=false and run migrations/*.sql
TYPEORM_SYNCHRONIZE=false

# PostgreSQL (TypeORM)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=rehma_blood

# Blood request invitations
INVITE_MAX_OUTSTANDING=3
INVITE_EXPIRY_POLL_MS=60000
INVITE_REASSIGN_BATCH=1

# Push (FCM HTTP v1). When FCM_PROJECT_ID is unset, mock push provider is used in-process.
# FCM_PROJECT_ID=your-firebase-project-id
# Credentials (never commit the JSON file):
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Or use Application Default Credentials on GCP/GCE/Cloud Run.

# Password recovery (email link). When disabled, API returns generic success without sending mail.
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_LINK_BASE=https://app.example.com/reset-password
# SMTP (required when PASSWORD_RESET_EMAIL_ENABLED=true)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
